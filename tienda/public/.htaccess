Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.html index.php
<FilesMatch "\.(ini|env|sql|log|bak|old|json|md)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# V92: revalidar HTML/PHP para evitar versiones antiguas del editor y la tienda.
<IfModule mod_headers.c>
<FilesMatch "\.(html|php)$">
Header always set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>

# V92: impedir ejecución de archivos en directorios de imágenes (defensa adicional en Apache).
<IfModule mod_headers.c>
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'"
</IfModule>

# V93.4: compresión de recursos de texto si el hosting tiene mod_deflate.
# Reduce la transferencia de la página y el catálogo; no altera los cálculos.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/ld+json image/svg+xml
</IfModule>

# Recursos con nombre basado en contenido: caché segura entre versiones.
<IfModule mod_headers.c>
<FilesMatch "^mpi_asset_[a-f0-9]{16}\.(png|webp)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
