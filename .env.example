# ============================================================================
# Mega Prime Import · variables para Docker / Coolify
# Copia este archivo como .env solo para pruebas locales.
# En Coolify configura estas variables en el recurso (no subas .env a Git).
# ============================================================================

# Conexión MariaDB. Formatos aceptados:
#   mysql://usuario:contraseña@host:3306/base
#   mariadb://usuario:contraseña@host:3306/base
# Si la URL incluye una base y el usuario NO puede crear tres bases, el
# instalador usa automáticamente esa única base (modo single).
MARIADB_URL=mysql://mpi:CONTRASENA@mariadb:3306/mpi

# Dominios canónicos (sin https:// ni barra final).
MPI_DOMAIN_TIENDA=megaprimeimport.com
MPI_DOMAIN_ACCESO=acceso.megaprimeimport.com
MPI_DOMAIN_LIQUIDACIONES=liquidaciones.megaprimeimport.com

# auto   = intenta 3 bases y si no hay permisos usa la base de MARIADB_URL
# separate = exige crear/acceder a 3 bases separadas (recomendado)
# single = usa una sola base para los tres esquemas
MPI_DB_MODE=auto
MPI_DB_PREFIX=mpi

# Nombres explícitos (opcional). Si se omiten: <prefijo>_tienda, etc.
# MPI_DB_TIENDA=mpi_tienda
# MPI_DB_IDENTIDAD=mpi_identidad
# MPI_DB_LIQUIDACIONES=mpi_liquidaciones

# Credenciales por base (opcional; por defecto usa las de MARIADB_URL).
# MPI_DB_USER_TIENDA=
# MPI_DB_PASSWORD_TIENDA=
# MPI_DB_USER_IDENTIDAD=
# MPI_DB_PASSWORD_IDENTIDAD=
# MPI_DB_USER_LIQUIDACIONES=
# MPI_DB_PASSWORD_LIQUIDACIONES=

# Clave estable para sesiones/IP y para derivar los secretos SSO.
# Si se omite, se genera una vez y se guarda en el volumen /data.
# MPI_APP_KEY=

# SSO entre tienda, acceso y liquidaciones (recomendado: 1).
MPI_ENABLE_SSO=1
# Si se omiten, se derivan de MPI_APP_KEY y coinciden en las tres apps.
# MPI_SSO_SECRET_TIENDA=
# MPI_SSO_SECRET_LIQUIDACIONES=

# Primer administrador. Si MPI_ADMIN_PASSWORD se omite, se genera una
# contraseña aleatoria y se guarda en /data/initial_admin.txt (solo primera vez).
MPI_ADMIN_EMAIL=admin@megaprimeimport.com
MPI_ADMIN_USERNAME=admin
# MPI_ADMIN_PASSWORD=UnaClaveLargaDe12Omas

MPI_SEED_ADMIN=1
# 1 = carga el catálogo DEMO (27 productos) la primera vez.
# Para producción real usa 0 y reemplaza los datos ficticios.
MPI_SEED_DEMO=1
# Si se omite, hereda el valor de MPI_SEED_DEMO.
# MP_ALLOW_DEMO_PUBLIC=1
MPI_RUN_MIGRATIONS=1
MPI_DB_CONNECT_RETRIES=30

# URL pública de la tienda (recuperación de contraseña por correo).
# Si se omite, se usa https://<MPI_DOMAIN_TIENDA>.
# MP_PUBLIC_BASE_URL=https://megaprimeimport.com
# MP_RESET_FROM=no-responder@megaprimeimport.com
